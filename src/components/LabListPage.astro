---
/**
 * LabListPage.astro —— 实验室四个板块列表页的版式
 *
 * 四个列表页（Python / Julia / ES6 / 数据结构）原本各带一份约 200 行、几乎逐字
 * 相同的 scoped style，而且分区顺序各自为政——最该先看的「项目实战」「源码」
 * 反而排在最后。这个组件把版式收成一份，并把分区顺序交给调用方显式声明。
 *
 * 分区模型：每个 section 有三种形态，用哪个取决于数据长什么样。
 *   - rows  ：带篇号/标签的宽行，用于「按顺序读」这类有序篇目
 *   - mini  ：两列紧凑列表，用于源码、演示页这类并列资源
 *   - chips ：胶囊标签，用于逐课入口这类短名字
 * 这样四个板块只需各自描述「有哪些区、每区什么形态」，样式只有一份。
 *
 * ⚠️ 三条防溢出规则别删（320px 实测过）：
 *   1. ≤640px 隐藏 .row__note，否则长描述会把箭头挤出屏幕
 *   2. ≤640px 给 .row__title 放开 flex-shrink 并加 min-width:0
 *   3. ≤640px .mini 从 2 列降为 1 列
 */
import BaseLayout from '../layouts/BaseLayout.astro';

export interface LabRowLink {
  /** 站内绝对路径 */
  href: string;
  /** 行首序号，如 '01'。不传则整列省略 */
  no?: string;
  title: string;
  /** 行右侧说明文字 */
  note?: string;
  /** 行尾的等宽小标签，如实现文件名 */
  code?: string;
  /** 行尾追加的「讲解」胶囊，指向配套讲解页 */
  pill?: { href: string; label: string };
  /**
   * 整行包一层两栏容器（.item），让这一行有/无 pill 都占同一条右边界。
   * 演示区需要它（该区部分行有 pill、部分没有）；纯篇目列表不需要。
   */
  twoCol?: boolean;
}

export interface LabMiniLink {
  href: string;
  title: string;
}

export interface LabChipLink {
  href: string;
  title: string;
}

export type LabSection =
  | { kind: 'rows'; title: string; note?: string; links: LabRowLink[]; footnote?: string }
  | { kind: 'mini'; title: string; note?: string; links: LabMiniLink[] }
  | { kind: 'chips'; title: string; note?: string; links: LabChipLink[] };

interface Props {
  title: string;
  description: string;
  /** 'LAB / PYTHON' 这行小字 */
  eyebrow: string;
  /** 导语段落，支持传 HTML 片段（<strong>/<code>） */
  intro: string[];
  sections: LabSection[];
}

const { title, description, eyebrow, intro, sections }: Props = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="wrap page-head">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    {intro.map((p) => <p class="muted" set:html={p} />)}
  </div>

  <div class="wrap lab-body">
    {
      sections.map((s) => (
        <section class="block">
          <h2 class="block__title">{s.title}</h2>
          {s.note && <p class="block__note" set:html={s.note} />}

          {s.kind === 'rows' && (
            <ul class="rows">
              {s.links.map((l) => (
                /* twoCol 的行包一层两栏容器，胶囊有就渲染、没有就留空 */
                <li class={l.twoCol ? 'item' : undefined}>
                  <a class="row" href={l.href}>
                    {l.no && <span class="row__no">{l.no}</span>}
                    <span class="row__title">{l.title}</span>
                    {l.note && <span class="row__note" set:html={l.note} />}
                    {l.code && <span class="row__code">{l.code}</span>}
                    <svg class="row__arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                      <path d="M5 11L11 5M6 5h5v5"></path>
                    </svg>
                  </a>
                  {l.pill && (
                    <a class="pill" href={l.pill.href}>
                      {l.pill.label}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          )}

          {s.kind === 'mini' && (
            <ul class="mini">
              {s.links.map((l) => (
                <li>
                  <a href={l.href}>
                    <span>{l.title}</span>
                    <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                      <path d="M5 11L11 5M6 5h5v5"></path>
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )}

          {s.kind === 'chips' && (
            <ul class="chips">
              {s.links.map((l) => (
                <li>
                  <a href={l.href}>{l.title}</a>
                </li>
              ))}
            </ul>
          )}

          {s.kind === 'rows' && s.footnote && (
            <p class="block__note" set:html={s.footnote} />
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: 64px 20px;
  }

  .page-head h1 {
    font-size: clamp(2.1rem, 6vw, 2.8rem);
    margin: 0 0 12px;
    letter-spacing: -0.035em;
  }

  .page-head .muted {
    margin: 0 0 10px;
    max-width: 46em;
    font-size: 0.95rem;
    line-height: 1.85;
  }

  .page-head strong {
    font-weight: 550;
  }

  .page-head code,
  .block__note code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
  }

  .lab-body {
    padding-bottom: 96px;
  }

  .block + .block {
    margin-top: 52px;
    padding-top: 44px;
    border-top: 1px solid var(--line);
  }

  .block__title {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .block__note {
    margin: 8px 0 20px;
    max-width: 46em;
    font-size: 0.87rem;
    line-height: 1.8;
    color: var(--fg-muted);
  }

  /* ---- rows：带序号的宽行 ---- */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows li + li {
    border-top: 1px solid var(--line);
  }

  /* 带「讲解」胶囊的行要变成两栏，让胶囊留在行外 */
  .rows li.item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .rows li.item .row {
    flex: 1;
    min-width: 0;
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 12px;
    margin-inline: -12px;
    border-radius: var(--radius-sm);
    color: var(--fg);
    transition: background-color 0.18s ease;
  }

  .row:hover {
    background: var(--bg-sunken);
  }

  .row__no {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
  }

  .row__title {
    flex-shrink: 0;
    font-size: 0.95rem;
    transition: color 0.18s ease;
  }

  .row:hover .row__title {
    color: var(--accent);
  }

  .row__note {
    flex: 1;
    min-width: 0;
    font-size: 0.82rem;
    color: var(--fg-faint);
  }

  .row__note code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--fg-muted);
  }

  .row__code {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--fg-faint);
  }

  .row__arrow {
    flex-shrink: 0;
    align-self: center;
    color: var(--fg-faint);
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .row:hover .row__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .pill {
    flex-shrink: 0;
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-faint);
    transition: all 0.16s ease;
  }

  .pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ---- mini：两列紧凑列表 ---- */
  .mini {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .mini a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 12px;
    margin-inline: -12px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--fg-muted);
    transition: all 0.16s ease;
  }

  .mini a svg {
    flex-shrink: 0;
    color: var(--fg-faint);
    opacity: 0;
    transition: all 0.16s ease;
  }

  .mini a:hover {
    background: var(--bg-sunken);
    color: var(--accent);
  }

  .mini a:hover svg {
    opacity: 1;
    color: var(--accent);
  }

  /* ---- chips：胶囊标签 ---- */
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips a {
    display: inline-block;
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-muted);
    transition: all 0.16s ease;
  }

  .chips a:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--bg-sunken);
  }

  @media (min-width: 640px) {
    .mini {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 32px;
    }
  }

  @media (max-width: 640px) {
    /* 防溢出 1：长描述会把行尾箭头挤出屏幕，窄屏直接不要它 */
    .row__note {
      display: none;
    }
    /* 防溢出 2：标题可能很长，放开收缩并允许换行 */
    .row__title {
      flex-shrink: 1;
      min-width: 0;
    }
    /* 防溢出 3：两列在窄屏会挤成竖排，降回单列 */
    .mini {
      grid-template-columns: 1fr;
    }
  }
</style>
