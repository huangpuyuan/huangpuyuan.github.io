---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime, postUrl } from '../../utils/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const catCount = new Map<string, number>();
for (const p of posts) {
  const c = p.data.category?.trim() || '随笔';
  catCount.set(c, (catCount.get(c) ?? 0) + 1);
}
const cats = [...catCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, [] as unknown as typeof posts);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout
  title="笔记"
  description={`共 ${posts.length} 篇笔记，涵盖研究、数据、经济学、人工智能与学习心得。`}
>
  <div class="wrap page-head">
    <span class="eyebrow">NOTES</span>
    <h1>笔记</h1>
    <p class="muted">一共 {posts.length} 篇，从 {years[years.length - 1]} 年写到今天。</p>

    <div class="filters" data-filters>
      <button class="chip is-active" type="button" data-filter="全部">全部 {posts.length}</button>
      {
        cats.map(([name, count]) => (
          <button class="chip" type="button" data-filter={name}>
            {name} {count}
          </button>
        ))
      }
    </div>
  </div>

  <div class="wrap" style="padding-bottom:96px">
    {
      years.map((y) => (
        <section class="year" data-year>
          <h2 class="year__label">{y}</h2>
          <ul class="rows">
            {byYear.get(y)!.map((post) => (
              <li data-cat={post.data.category?.trim() || '随笔'}>
                <a class="row" href={postUrl(post.id)}>
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  <div class="row__main">
                    <h3>{post.data.title}</h3>
                    <p>{post.data.summary}</p>
                  </div>
                  <span class="row__cat">{post.data.category ?? '随笔'}</span>
                  <span class="row__time">{readingTime(post.body ?? '')}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <p class="empty" data-empty hidden>这个分类下还没有文章。</p>
  </div>
</BaseLayout>

<script>
  function initFilters() {
    const root = document.querySelector<HTMLElement>('[data-filters]');
    if (!root) return;

    const chips = [...root.querySelectorAll<HTMLButtonElement>('.chip')];
    const rows = [...document.querySelectorAll<HTMLLIElement>('.rows li[data-cat]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-year]')];
    const empty = document.querySelector<HTMLElement>('[data-empty]');

    function apply(name: string) {
      chips.forEach((c) => c.classList.toggle('is-active', c.dataset.filter === name));
      let visible = 0;
      rows.forEach((li) => {
        const match = name === '全部' || li.dataset.cat === name;
        li.hidden = !match;
        if (match) visible++;
      });
      groups.forEach((g) => {
        const any = [...g.querySelectorAll<HTMLLIElement>('li[data-cat]')].some((li) => !li.hidden);
        g.hidden = !any;
      });
      if (empty) empty.hidden = visible > 0;
    }

    chips.forEach((chip) => {
      if (chip.dataset.bound === '1') return;
      chip.dataset.bound = '1';
      chip.addEventListener('click', () => apply(chip.dataset.filter || '全部'));
    });
  }

  document.addEventListener('astro:page-load', initFilters);
  initFilters();
</script>

<style>
  .page-head {
    padding-block: 64px 36px;
  }

  .page-head h1 {
    font-size: clamp(2.1rem, 6vw, 2.8rem);
    margin: 0 0 12px;
    letter-spacing: -0.035em;
  }

  .page-head p {
    margin: 0;
    font-size: 0.95rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .chip {
    font-family: inherit;
    font-size: 0.8rem;
    color: var(--fg-muted);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 14px;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .chip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .chip.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .year + .year {
    margin-top: 40px;
  }

  .year__label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    color: var(--fg-faint);
    font-weight: 500;
    margin: 0 0 4px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows li + li {
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 104px 1fr auto 76px;
    gap: 20px;
    align-items: baseline;
    padding: 20px 12px;
    margin-inline: -12px;
    border-radius: var(--radius);
    color: var(--fg);
    transition: background-color 0.18s ease;
  }

  .row:hover {
    background: var(--bg-sunken);
  }

  .row time {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--fg-faint);
  }

  .row__main h3 {
    margin: 0 0 5px;
    font-size: 1.05rem;
    transition: color 0.18s ease;
  }

  .row:hover .row__main h3 {
    color: var(--accent);
  }

  .row__main p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .row__cat,
  .row__time {
    font-size: 0.73rem;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .row__cat {
    font-family: var(--font-mono);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 1px 9px;
  }

  .row__time {
    text-align: right;
    font-family: var(--font-mono);
  }

  .empty {
    margin: 40px 0;
    text-align: center;
    color: var(--fg-faint);
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    .row {
      grid-template-columns: 1fr;
      gap: 9px;
      padding: 20px 0;
      margin-inline: 0;
    }
    .row__cat,
    .row__time {
      display: none;
    }
  }
</style>
