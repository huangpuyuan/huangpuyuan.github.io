---
import { statSync } from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import LabArticle from '../../../components/LabArticle.astro';

const ROOT = path.join(process.cwd(), 'public', 'lab', 'datastructures');

export async function getStaticPaths() {
  const all = (await getCollection('ds')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      no: i + 1,
      total: all.length,
      prev: all[i - 1] ?? null,
      next: all[i + 1] ?? null
    }
  }));
}

const { entry, no, total, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

/** 演示页和源码都在 public 里按原样托管，构建时确认文件真的在 */
function labFile(to?: string) {
  if (!to) return null;
  const full = path.join(ROOT, ...to.split('/'));
  try {
    if (statSync(full).isFile()) {
      // 逐段编码即可，别再套一层 encodeURI，否则 % 会被二次转义
      return '/lab/datastructures/' + to.split('/').map(encodeURIComponent).join('/');
    }
  } catch {}
  return null;
}

const demoUrl = labFile(entry.data.demo);
const sourceUrl = labFile(entry.data.source);
const pad = (n: number) => String(n).padStart(2, '0');

/**
 * 这个板块的页头没有标签/时长/日期那一行，只有一句出处。
 * 复杂度的 chips 单独传，因为它们渲染成胶囊标签而不是小字。
 */
const metaFrom = entry.data.chapter
  ? [`对应《学习 JavaScript 数据结构与算法》· ${entry.data.chapter}`]
  : [];

const acts = [
  demoUrl && {
    href: demoUrl,
    kind: '演示页',
    desc: '在浏览器里跑一遍，结果直接画在页面上'
  },
  sourceUrl && {
    href: sourceUrl,
    kind: '源码',
    desc: entry.data.source as string
  }
].filter(Boolean) as { href: string; kind: string; desc: string }[];
---

<LabArticle
  title={entry.data.title}
  description={entry.data.summary}
  crumbHref="/lab/datastructures/"
  crumbLabel="数据结构练习"
  eyebrow={`LAB / DATA STRUCTURES / ${pad(no)} OF ${pad(total)}`}
  summary={entry.data.summary}
  gist={entry.data.gist}
  metaFrom={metaFrom}
  chips={entry.data.complexity}
  toc={toc}
  prev={prev && { href: `/lab/datastructures/${prev.id}/`, title: prev.data.title }}
  next={next && { href: `/lab/datastructures/${next.id}/`, title: next.data.title }}
  backHref="/lab/datastructures/"
  backLabel="全部篇目与演示"
  acts={acts}
>
  <Content />
</LabArticle>
