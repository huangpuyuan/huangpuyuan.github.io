---
import { statSync } from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const ROOT = path.join(process.cwd(), 'public', 'lab', 'python');

type Entry = { title: string; to: string; note?: string };

// 讲解篇目，顺序由每篇的 order 决定
const guides = (await getCollection('python')).sort((a, b) => a.data.order - b.data.order);

const pad = (n: number) => String(n).padStart(2, '0');

const scripts: Entry[] = [
  { title: 'NumPy 基础', to: 'scripts/01_numpy.py', note: '数组、索引、切片' },
  { title: 'NumPy 进阶', to: 'scripts/02_numpy2.py', note: '广播、掩码、花式索引' },
  { title: 'Pandas 入门', to: 'scripts/03_pandas.py', note: 'Series / DataFrame / 清洗' },
  { title: 'Pandas 实战', to: 'scripts/04_pandas_planets.py', note: '行星数据集完整流程，7 张图' },
  { title: '手写 KNN', to: 'scripts/05_numpy_knn.py', note: '纯 NumPy，距离与投票' },
  { title: '鸢尾花 KNN', to: 'scripts/06_iris_knn.py', note: 'sklearn 三行搞定' },
  { title: '线性回归', to: 'scripts/07_planets_ml.py', note: '含一个失败案例' },
  { title: '类与继承', to: 'scripts/08_class.py', note: '已修复覆盖 bug' },
  { title: '快速排序', to: 'scripts/09_quicksort.py', note: '列表推导版分区' },
  { title: '凯撒密码', to: 'scripts/10_caesar_shift.py', note: '用 partial 绑定参数' },
  { title: '猜数字', to: 'scripts/11_numberguess.py', note: '需要交互输入' },
  { title: '猜年龄', to: 'scripts/12_age.py', note: '二分法，6 次问到 1.875' },
  { title: '解方程', to: 'scripts/13_solf.py', note: '二分法求三次方程零点' },
  { title: '条件判断', to: 'scripts/14_ifelse.py', note: '需要交互输入' },
  { title: '随机数', to: 'scripts/15_random.py', note: '七个接口，固定种子' },
  { title: '集合运算', to: 'scripts/16_set.py', note: '差集、并集、交集' },
  { title: '输入类型', to: 'scripts/17_input_type.py', note: '需要交互输入' },
  { title: '身份与复制', to: 'scripts/18_identity.py', note: 'id() 与浅复制' },
  { title: 'Adult 数据集', to: 'scripts/19_adult.py', note: '32561 行人口数据 + 3 张图' }
];

const dataFiles: Entry[] = [
  { title: 'data.csv', to: 'data/data.csv', note: '人名小表' },
  { title: 'planets.csv', to: 'data/planets.csv', note: '1035 行系外行星数据' },
  { title: 'adult.csv', to: 'data/adult.csv', note: '32561 行 UCI 人口数据（3.8MB）' }
];

function exists(to: string) {
  try {
    return statSync(path.join(ROOT, ...to.split('/'))).isFile();
  } catch {
    return false;
  }
}

function keep(list: Entry[]) {
  return list.filter((e) => (exists(e.to) ? true : (console.warn('[python] 找不到 ' + e.to), false)));
}

const shownScripts = keep(scripts);
const shownData = keep(dataFiles);
---

<BaseLayout
  title="Python 学习笔记"
  description="2018 年学语法，2024 年做数据分析。两批笔记合在一起：从猜数字游戏到 KNN 分类器，中间隔了六年。"
>
  <div class="wrap page-head">
    <span class="eyebrow">LAB / PYTHON</span>
    <h1>Python 学习笔记</h1>
    <p class="muted">
      这里放着两段学习痕迹，中间隔了六年。2018 年那批是<strong>学语法</strong>——
      写猜数字游戏、用二分法解方程、练 <code>if/else</code> 和集合操作，代码都很短。
    </p>
    <p class="muted">
      2024 年那批是<strong>学工具</strong>——NumPy 的广播、Pandas 的清洗、sklearn 的建模流程。
      重点从「语法怎么写」变成了「一条数据从读到出结果要走几步」。
    </p>
    <p class="muted">
      每个脚本都在无头环境里真跑过一遍，文章里引的输出和数字都是从实际运行结果里抄的，
      不是照着源码猜的。图也是跑出来直接存成 SVG 的。
    </p>
  </div>

  <div class="wrap" style="padding-bottom:96px">
    <section class="block">
      <h2 class="block__title">按顺序读</h2>
      <p class="block__note">
        从数组思维开始，到建模收尾。每篇都能独立看，想跳着读也行。
      </p>
      <ul class="rows">
        {
          guides.map((g, i) => (
            <li>
              <a class="row" href={`/lab/python/${g.id}/`}>
                <span class="row__no">{pad(i + 1)}</span>
                <span class="row__title">{g.data.title}</span>
                <span class="row__note">{g.data.gist ?? g.data.description}</span>
                <svg class="row__arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 11L11 5M6 5h5v5"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2 class="block__title">源码</h2>
      <p class="block__note">
        直接点开是文本，浏览器会原样显示。想自己跑，装好
        <code>numpy pandas scikit-learn seaborn matplotlib</code> 之后进到
        <code>scripts/</code> 目录执行 <code>python3 01_numpy.py</code> 就行。
      </p>
      <ul class="mini">
        {
          shownScripts.map((s) => (
            <li>
              <a href={`/lab/python/${encodeURI(s.to)}`}>
                <span>{s.title}</span>
                <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 11L11 5M6 5h5v5"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2 class="block__title">数据文件</h2>
      <p class="block__note">
        <code>planets.csv</code> 原来是 seaborn 联网加载的，我导出成 CSV 放在这里，
        这样脚本不依赖网络也能跑。
      </p>
      <ul class="mini">
        {
          shownData.map((s) => (
            <li>
              <a href={`/lab/python/${encodeURI(s.to)}`}>
                <span>{s.title}</span>
                <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 11L11 5M6 5h5v5"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: 64px 20px;
  }

  .page-head h1 {
    font-size: clamp(2.1rem, 6vw, 2.8rem);
    margin: 0 0 12px;
    letter-spacing: -0.035em;
  }

  .page-head p {
    margin: 0 0 10px;
    max-width: 46em;
    font-size: 0.95rem;
    line-height: 1.85;
  }

  .page-head strong {
    font-weight: 550;
  }

  .page-head code,
  .block__note code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
  }

  .block + .block {
    margin-top: 52px;
    padding-top: 44px;
    border-top: 1px solid var(--line);
  }

  .block__title {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .block__note {
    margin: 8px 0 20px;
    max-width: 46em;
    font-size: 0.87rem;
    line-height: 1.8;
    color: var(--fg-muted);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows li + li {
    border-top: 1px solid var(--line);
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 12px;
    margin-inline: -12px;
    border-radius: var(--radius-sm);
    color: var(--fg);
    transition: background-color 0.18s ease;
  }

  .row:hover {
    background: var(--bg-sunken);
  }

  .row__title {
    flex-shrink: 0;
    font-size: 0.95rem;
    transition: color 0.18s ease;
  }

  .row__no {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
  }

  .row:hover .row__title {
    color: var(--accent);
  }

  .row__note {
    flex: 1;
    min-width: 0;
    font-size: 0.82rem;
    color: var(--fg-faint);
  }

  .row__arrow {
    flex-shrink: 0;
    align-self: center;
    color: var(--fg-faint);
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .row:hover .row__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .mini {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .mini a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 12px;
    margin-inline: -12px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--fg-muted);
    transition: all 0.16s ease;
  }

  .mini a svg {
    flex-shrink: 0;
    color: var(--fg-faint);
    opacity: 0;
    transition: all 0.16s ease;
  }

  .mini a:hover {
    background: var(--bg-sunken);
    color: var(--accent);
  }

  .mini a:hover svg {
    opacity: 1;
    color: var(--accent);
  }

  @media (min-width: 640px) {
    .mini {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .row__note {
      display: none;
    }
    /* 窄屏下标题可能很长（比如「Pandas 实战：1035 颗行星的完整分析」），
       不放开收缩会把右侧箭头挤出屏幕 */
    .row__title {
      flex-shrink: 1;
      min-width: 0;
    }
  }
</style>
