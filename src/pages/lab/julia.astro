---
import { statSync } from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import LabListPage from '../../components/LabListPage.astro';
import type { LabSection } from '../../components/LabListPage.astro';

const ROOT = path.join(process.cwd(), 'public', 'lab', 'julia');

type Entry = { title: string; to: string; note?: string; code?: string };

// 讲解篇目，顺序由每篇的 order 决定
const guides = (await getCollection('julia')).sort((a, b) => a.data.order - b.data.order);

const pad = (n: number) => String(n).padStart(2, '0');

const scripts: Entry[] = [
  { title: '掷骰子', to: 'scripts/dice.jl', note: '组合数 vs 蒙特卡洛', code: 'dice.jl' },
  { title: '猜密码', to: 'scripts/password.jl', note: '1000 万次能蒙中多少', code: 'password.jl' },
  { title: '中心极限定理', to: 'scripts/monte-carlo.jl', note: '顺带量了性能差', code: 'monte-carlo.jl' },
  { title: '画函数图像', to: 'scripts/plot-function.jl', note: '需要 Plots 依赖', code: 'plot-function.jl' }
];

function exists(to: string) {
  try {
    return statSync(path.join(ROOT, ...to.split('/'))).isFile();
  } catch {
    return false;
  }
}

function keep(list: Entry[]) {
  return list.filter((e) => (exists(e.to) ? true : (console.warn('[julia] 找不到 ' + e.to), false)));
}

const shownScripts = keep(scripts);

/** 分区顺序：源码在前（这是这个板块最实在的东西），篇目在后 */
const sections: LabSection[] = [
  {
    kind: 'mini',
    title: '源码',
    note: '直接点开是文本，浏览器会原样显示。想自己跑，先装 Julia，然后：<code>julia scripts/dice.jl</code>。',
    links: shownScripts.map((s) => ({ href: `/lab/julia/${encodeURI(s.to)}`, title: s.title }))
  },
  {
    kind: 'rows',
    title: '按顺序读',
    note: '从最简单的骰子开始，一路到性能实测。每篇都是独立的，想跳着看也行。',
    links: guides.map((g, i) => ({
      href: `/lab/julia/${g.id}/`,
      no: pad(i + 1),
      title: g.data.title,
      note: g.data.gist ?? g.data.summary
    }))
  }
];
---

<LabListPage
  title="Julia 统计模拟"
  description="2019 年学 Julia 时写的四个小脚本，用随机模拟去逼近一些算起来麻烦、但掷骰子就能出答案的问题。"
  eyebrow="LAB / JULIA"
  intro={[
    '有一类问题公式推起来很麻烦，但<strong>用随机数掷很多次就能出答案</strong>。这类方法叫蒙特卡洛模拟，代价是要跑很多次，所以特别挑语言性能——这正是 Julia 的用武之地。',
    '下面这四个脚本是 2019 年 8 月学统计模拟时写的。浏览器跑不了 Julia，所以这里做成了「代码 + 实测输出 + 讲解」的形式：每篇都写清楚在算什么、为什么这么写、以及跑出来什么结果。代码按 Julia 1.x 重写过了——原版有几处用的是 0.6 时代的老写法，现在跑不起来。'
  ]}
  sections={sections}
/>
