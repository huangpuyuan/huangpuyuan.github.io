---
import { statSync } from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import LabListPage from '../../components/LabListPage.astro';
import type { LabSection } from '../../components/LabListPage.astro';

const ROOT = path.join(process.cwd(), 'public', 'lab', 'es6');

type Entry = { title: string; to: string; note?: string };

// 讲解篇目，顺序由每篇的 order 决定
const guides = (await getCollection('es6')).sort((a, b) => a.data.order - b.data.order);

const pad = (n: number) => String(n).padStart(2, '0');

// 17 个 lesson 演示页，按主题分组（和讲解篇目对应）
const demos: { title: string; to: string }[] = [
  { title: '变量与作用域', to: 'lessons/demo-variables.html' },
  { title: '解构赋值', to: 'lessons/demo-destructure.html' },
  { title: '正则扩展', to: 'lessons/demo-regex.html' },
  { title: '字符串与数值扩展', to: 'lessons/demo-string.html' },
  { title: '数组与函数扩展', to: 'lessons/demo-array.html' },
  { title: '对象扩展与 Symbol', to: 'lessons/demo-object.html' },
  { title: 'Set 与 Map', to: 'lessons/demo-setmap.html' },
  { title: 'Proxy 与 Reflect', to: 'lessons/demo-proxy.html' },
  { title: '类与继承', to: 'lessons/demo-class.html' },
  { title: 'Promise 与异步', to: 'lessons/demo-promise.html' },
  { title: '迭代器', to: 'lessons/demo-iterator.html' },
  { title: 'Generator', to: 'lessons/demo-generator.html' }
];

function exists(to: string) {
  try {
    return statSync(path.join(ROOT, ...to.split('/'))).isFile();
  } catch {
    return false;
  }
}

const shownDemos = demos.filter((d) =>
  exists(d.to) ? true : (console.warn('[es6] 找不到 ' + d.to), false)
);

// 项目实战：17 个 lesson 之外的单体项目，演示页不在 lessons/ 下，单独列
const projectTo = 'project/architecture.html';
const projectOk = exists(projectTo);

const singles = Array.from({ length: 17 }, (_, i) => `lesson${i + 1}`).filter((name) =>
  exists(`lessons/${name}.html`)
);

/**
 * 分区顺序：把「项目实战」提到最前。
 * 它是唯一一个「把语法真正用起来」的成品，对第一次来的人价值最高；
 * 而按顺序读那 10 篇是线性学习路径，放第二位。
 */
const sections: LabSection[] = [
  {
    kind: 'rows',
    title: '项目实战',
    note: '17 个 lesson 都是孤立的语法点。最后这个项目把它们凑起来用了——555 行、五个文件分层，用 <code>Map</code> 存配置表、<code>Set</code> 去重、手写组合枚举，最后用一段反射代码把四块能力拼成一个类。<strong>0 依赖、0 构建</strong>，打开就是源码，跑的就是源码。',
    links: [
      {
        href: '/lab/es6/project/demo/',
        no: '01',
        title: '项目演示',
        note: '组合运算 / 倒计时 / 数据层，三个区域都能点，控制台零报错'
      },
      {
        href: '/lab/es6/project/architecture.html',
        no: '02',
        title: '架构讲解',
        note: '逐文件拆解：为什么要分层、mixin 是怎么实现的、有什么隐患'
      },
      {
        href: '/lab/es6/project/src/base.js',
        no: '03',
        title: '源码目录',
        note: '<code>base.js</code> / <code>calculate.js</code> / <code>interface.js</code> / <code>timer.js</code> / <code>index.js</code>'
      }
    ],
    footnote: projectOk
      ? undefined
      : '（项目产物还没生成，先跑 <code>node scripts/build-es6-project.mjs</code>）'
  },
  {
    kind: 'rows',
    title: '按顺序读',
    note: '17 个 lesson 按主题合成 9 篇讲解。每篇都能独立看，想跳着读也行。',
    links: guides.map((g, i) => ({
      href: `/lab/es6/${g.id}/`,
      no: pad(i + 1),
      title: g.data.title,
      note: g.data.gist ?? g.data.description
    }))
  },
  {
    kind: 'mini',
    title: '演示页（按主题）',
    note: '每组演示页装一到两个 lesson 的原始代码，打开就跑。这些页面是独立 HTML，不带站点导航，返回靠左下角那个小浮标。',
    links: shownDemos.map((d) => ({ href: `/lab/es6/${encodeURI(d.to)}`, title: d.title }))
  },
  {
    kind: 'chips',
    title: '逐课打开',
    note: '想按原编号一课一课看就点这里。每页只装一个 lesson 的源码和输出。',
    links: singles.map((name) => ({ href: `/lab/es6/lessons/${name}.html`, title: name }))
  }
];
---

<LabListPage
  title="ES6 语法练习"
  description="2017 年跟着教程过了一遍 ES6 语法，17 个 lesson。当年靠 gulp + babel 才跑得起来，现在这些语法早就进了标准——一个 script 标签就够。"
  eyebrow="LAB / ES6"
  intro={[
    '2017 年 4 月跟着一套教程把 ES6 新语法过了一遍，从 <code>let</code>/<code>const</code> 一路写到 Generator，攒下 17 个 lesson。当年很折腾——仓库里配着 <strong>gulp 3.9 + webpack 2 + babel-preset-es2015</strong>，写个 <code>let</code> 都要编译一遍；<strong>现在这些语法全都进了标准</strong>，整个构建栈可以删掉，只剩一个 <code>&lt;script&gt;</code> 标签。',
    '所以这里做成了可以直接打开的页面：右侧是原样保留的源码，左侧是跑出来的输出。29 个页面全部在无头浏览器里真跑过一遍（其中 <strong>lesson16 和 lesson17 无法原生执行</strong>——前者用了至今未进标准的修饰器，后者是 ES 模块语法，这两页标明了原因并附了行为等价的改写）。'
  ]}
  sections={sections}
/>
