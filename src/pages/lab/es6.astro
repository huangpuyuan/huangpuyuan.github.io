---
import { statSync } from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const ROOT = path.join(process.cwd(), 'public', 'lab', 'es6');

type Entry = { title: string; to: string; note?: string };

// 讲解篇目，顺序由每篇的 order 决定
const guides = (await getCollection('es6')).sort((a, b) => a.data.order - b.data.order);

const pad = (n: number) => String(n).padStart(2, '0');

// 17 个 lesson 演示页，按主题分组（和讲解篇目对应）
const demos: { title: string; to: string }[] = [
  { title: '变量与作用域', to: 'lessons/demo-variables.html' },
  { title: '解构赋值', to: 'lessons/demo-destructure.html' },
  { title: '正则扩展', to: 'lessons/demo-regex.html' },
  { title: '字符串与数值扩展', to: 'lessons/demo-string.html' },
  { title: '数组与函数扩展', to: 'lessons/demo-array.html' },
  { title: '对象扩展与 Symbol', to: 'lessons/demo-object.html' },
  { title: 'Set 与 Map', to: 'lessons/demo-setmap.html' },
  { title: 'Proxy 与 Reflect', to: 'lessons/demo-proxy.html' },
  { title: '类与继承', to: 'lessons/demo-class.html' },
  { title: 'Promise 与异步', to: 'lessons/demo-promise.html' },
  { title: '迭代器', to: 'lessons/demo-iterator.html' },
  { title: 'Generator', to: 'lessons/demo-generator.html' }
];

function exists(to: string) {
  try {
    return statSync(path.join(ROOT, ...to.split('/'))).isFile();
  } catch {
    return false;
  }
}

const shownDemos = demos.filter((d) =>
  exists(d.to) ? true : (console.warn('[es6] 找不到 ' + d.to), false)
);

const singles = Array.from({ length: 17 }, (_, i) => `lesson${i + 1}`).filter((name) =>
  exists(`lessons/${name}.html`)
);
---

<BaseLayout
  title="ES6 语法练习"
  description="2017 年跟着教程过了一遍 ES6 语法，17 个 lesson。当年靠 gulp + babel 才跑得起来，现在这些语法早就进了标准——一个 script 标签就够。"
>
  <div class="wrap page-head">
    <span class="eyebrow">LAB / ES6</span>
    <h1>ES6 语法练习</h1>
    <p class="muted">
      2017 年 4 月跟着一套教程把 ES6 新语法过了一遍，从 <code>let</code>/<code>const</code>
      一路写到 Generator，攒下 17 个 lesson。
    </p>
    <p class="muted">
      当年很折腾——仓库里配着 <strong>gulp 3.9 + webpack 2 + babel-preset-es2015</strong>，
      写个 <code>let</code> 都要编译一遍。<strong>现在这些语法全都进了标准</strong>，
      整个构建栈可以删掉，只剩一个 <code>&lt;script&gt;</code> 标签。
    </p>
    <p class="muted">
      所以这里做成了可以直接打开的页面：右侧是原样保留的源码，左侧是跑出来的输出。
      这些脚本清一色只写 <code>console.log</code>，不加输出镜像就是一片空白。
    </p>
    <p class="muted">
      29 个页面全部在无头浏览器里真跑过一遍。其中 <strong>lesson16 和 lesson17
      无法原生执行</strong>——前者用了至今未进标准的修饰器，后者是 ES 模块语法。
      这两页标明了原因，并附了行为等价的改写。
    </p>
  </div>

  <div class="wrap" style="padding-bottom:96px">
    <section class="block">
      <h2 class="block__title">按顺序读</h2>
      <p class="block__note">
        17 个 lesson 按主题合成 9 篇讲解。每篇都能独立看，想跳着读也行。
      </p>
      <ul class="rows">
        {
          guides.map((g, i) => (
            <li>
              <a class="row" href={`/lab/es6/${g.id}/`}>
                <span class="row__no">{pad(i + 1)}</span>
                <span class="row__title">{g.data.title}</span>
                <span class="row__note">{g.data.gist ?? g.data.description}</span>
                <svg class="row__arrow" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 11L11 5M6 5h5v5"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2 class="block__title">演示页（按主题）</h2>
      <p class="block__note">
        每组演示页装一到两个 lesson 的原始代码，打开就跑。顺带说明：这些页面是独立
        HTML，不带站点导航，返回靠左下角那个小浮标。
      </p>
      <ul class="mini">
        {
          shownDemos.map((d) => (
            <li>
              <a href={`/lab/es6/${encodeURI(d.to)}`}>
                <span>{d.title}</span>
                <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 11L11 5M6 5h5v5"></path>
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2 class="block__title">逐课打开</h2>
      <p class="block__note">
        想按原编号一课一课看就点这里。每页只装一个 lesson 的源码和输出。
      </p>
      <ul class="chips">
        {
          singles.map((name) => (
            <li>
              <a href={`/lab/es6/lessons/${name}.html`}>{name}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: 64px 20px;
  }

  .page-head h1 {
    font-size: clamp(2.1rem, 6vw, 2.8rem);
    margin: 0 0 12px;
    letter-spacing: -0.035em;
  }

  .page-head p {
    margin: 0 0 10px;
    max-width: 46em;
    font-size: 0.95rem;
    line-height: 1.85;
  }

  .page-head strong {
    font-weight: 550;
  }

  .page-head code,
  .block__note code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
  }

  .block + .block {
    margin-top: 52px;
    padding-top: 44px;
    border-top: 1px solid var(--line);
  }

  .block__title {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .block__note {
    margin: 8px 0 20px;
    max-width: 46em;
    font-size: 0.87rem;
    line-height: 1.8;
    color: var(--fg-muted);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows li + li {
    border-top: 1px solid var(--line);
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 12px;
    margin-inline: -12px;
    border-radius: var(--radius-sm);
    color: var(--fg);
    transition: background-color 0.18s ease;
  }

  .row:hover {
    background: var(--bg-sunken);
  }

  .row__title {
    flex-shrink: 0;
    font-size: 0.95rem;
    transition: color 0.18s ease;
  }

  .row__no {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
  }

  .row:hover .row__title {
    color: var(--accent);
  }

  .row__note {
    flex: 1;
    min-width: 0;
    font-size: 0.82rem;
    color: var(--fg-faint);
  }

  .row__arrow {
    flex-shrink: 0;
    align-self: center;
    color: var(--fg-faint);
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .row:hover .row__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .mini {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .mini a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 12px;
    margin-inline: -12px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--fg-muted);
    transition: all 0.16s ease;
  }

  .mini a svg {
    flex-shrink: 0;
    color: var(--fg-faint);
    opacity: 0;
    transition: all 0.16s ease;
  }

  .mini a:hover {
    background: var(--bg-sunken);
    color: var(--accent);
  }

  .mini a:hover svg {
    opacity: 1;
    color: var(--accent);
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips a {
    display: inline-block;
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-muted);
    transition: all 0.16s ease;
  }

  .chips a:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--bg-sunken);
  }

  @media (min-width: 640px) {
    .mini {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 32px;
    }
  }

  @media (max-width: 640px) {
    .row__note {
      display: none;
    }
    /* 窄屏下标题可能很长，不放开收缩会把右侧箭头挤出屏幕 */
    .row__title {
      flex-shrink: 1;
      min-width: 0;
    }
  }
</style>
