---
import { statSync } from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import LabArticle from '../../../components/LabArticle.astro';

const ROOT = path.join(process.cwd(), 'public', 'lab', 'python');

export async function getStaticPaths() {
  const all = (await getCollection('python')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      no: i + 1,
      total: all.length,
      prev: all[i - 1] ?? null,
      next: all[i + 1] ?? null
    }
  }));
}

const { entry, no, total, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

/** 脚本与数据都在 public 里按原样托管，构建时确认文件真的在 */
function labFile(kind: string, name?: string) {
  if (!name) return null;
  const rel = `${kind}/${name}`;
  const full = path.join(ROOT, ...rel.split('/'));
  try {
    if (statSync(full).isFile()) {
      // 逐段编码即可，别再套一层 encodeURI，否则 % 会被二次转义
      return '/lab/python/' + rel.split('/').map(encodeURIComponent).join('/');
    }
  } catch {}
  return null;
}

const scriptUrl = labFile('scripts', entry.data.script);
const pad = (n: number) => String(n).padStart(2, '0');

/** 页头小字：标签 / 时长 / 更新日期，有哪个显示哪个 */
const metaFrom = [
  entry.data.tag,
  entry.data.minutes && `约 ${entry.data.minutes} 分钟`,
  entry.data.updated && `更新于 ${entry.data.updated}`
].filter(Boolean) as string[];

const acts = scriptUrl
  ? [
      {
        href: scriptUrl,
        kind: '完整脚本',
        desc: `${entry.data.script} —— 直接点开是文本，复制到本地就能跑`
      },
      {
        static: true as const,
        kind: '怎么运行',
        desc: '装好依赖后进到 scripts/ 目录，执行',
        code: `python3 ${entry.data.script}`
      }
    ]
  : [];
---

<LabArticle
  title={entry.data.title}
  description={entry.data.description}
  crumbHref="/lab/python/"
  crumbLabel="Python 学习笔记"
  eyebrow={`LAB / PYTHON / ${pad(no)} OF ${pad(total)}`}
  summary={entry.data.description}
  gist={entry.data.gist}
  metaFrom={metaFrom}
  toc={toc}
  prev={prev && { href: `/lab/python/${prev.id}/`, title: prev.data.title }}
  next={next && { href: `/lab/python/${next.id}/`, title: next.data.title }}
  backHref="/lab/python/"
  backLabel="全部篇目与脚本"
  acts={acts}
>
  <Content />
</LabArticle>
