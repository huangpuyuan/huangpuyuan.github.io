---
import { statSync } from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import LabArticle from '../../../components/LabArticle.astro';

const ROOT = path.join(process.cwd(), 'public', 'lab', 'es6');

export async function getStaticPaths() {
  const all = (await getCollection('es6')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      no: i + 1,
      total: all.length,
      prev: all[i - 1] ?? null,
      next: all[i + 1] ?? null
    }
  }));
}

const { entry, no, total, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

/** 演示页都在 public 里按原样托管，构建时确认文件真的在 */
function labFile(to?: string) {
  if (!to) return null;
  const full = path.join(ROOT, 'lessons', ...to.split('/'));
  try {
    if (statSync(full).isFile()) {
      // 逐段编码即可，别再套一层 encodeURI，否则 % 会被二次转义
      return '/lab/es6/lessons/' + to.split('/').map(encodeURIComponent).join('/');
    }
  } catch {}
  return null;
}

const demoUrl = labFile(entry.data.demo) ?? entry.data.demoPath ?? null;
const extraUrl = entry.data.extraPath ?? null;
const pad = (n: number) => String(n).padStart(2, '0');

/** 页头小字：标签 / 时长 / 原课程对应课次 / 更新日期 */
const metaFrom = [
  entry.data.tag,
  entry.data.minutes && `约 ${entry.data.minutes} 分钟`,
  entry.data.lessons && `对应 lesson ${entry.data.lessons}`,
  entry.data.updated && `更新于 ${entry.data.updated}`
].filter(Boolean) as string[];

/**
 * 行动卡片。
 * demoPath 是「站点根路径形式的演示页」（如项目实战），demo 是 lessons/ 下的原课程演示页，
 * 两者的说明文案不一样——前者三个区域都能点，后者顶部是 console 输出镜像。
 */
const acts = demoUrl
  ? [
      {
        href: demoUrl,
        kind: '在浏览器里跑',
        desc: entry.data.demoPath
          ? `${entry.data.demoPath} —— 打开就跑，三个区域都能点`
          : `${entry.data.demo} —— 打开就跑，顶部是 console 输出镜像`
      },
      extraUrl
        ? {
            href: extraUrl,
            kind: entry.data.extraLabel ?? '另一个入口',
            desc: `${extraUrl} —— 逐文件讲这份代码是怎么组织的`
          }
        : {
            static: true as const,
            kind: '说明',
            desc: '这些演示页是独立 HTML，不带站点导航，返回按左下角的浮标'
          }
    ]
  : [];
---

<LabArticle
  title={entry.data.title}
  description={entry.data.description}
  crumbHref="/lab/es6/"
  crumbLabel="ES6 语法练习"
  eyebrow={`LAB / ES6 / ${pad(no)} OF ${pad(total)}`}
  summary={entry.data.description}
  gist={entry.data.gist}
  metaFrom={metaFrom}
  toc={toc}
  prev={prev && { href: `/lab/es6/${prev.id}/`, title: prev.data.title }}
  next={next && { href: `/lab/es6/${next.id}/`, title: next.data.title }}
  backHref="/lab/es6/"
  backLabel="全部篇目与演示页"
  acts={acts}
>
  <Content />
</LabArticle>
