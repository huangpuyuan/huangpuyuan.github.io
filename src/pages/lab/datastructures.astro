---
import { statSync } from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import LabListPage from '../../components/LabListPage.astro';
import type { LabSection } from '../../components/LabListPage.astro';

const ROOT = path.join(process.cwd(), 'public', 'lab', 'datastructures');

type Entry = { title: string; to: string; note?: string; code?: string };

// 「跟着做一遍」系列，顺序由每篇的 order 决定
const guides = (await getCollection('ds')).sort((a, b) => a.data.order - b.data.order);

// 演示页 -> 对应的讲解，点演示之前可以先看步骤
const guideByDemo = new Map(
  guides.filter((g) => g.data.demo).map((g) => [g.data.demo as string, g])
);

const pad = (n: number) => String(n).padStart(2, '0');

const demos: Entry[] = [
  { title: '二叉搜索树', to: 'trees/binarySearchTree.html', note: '插入、三种遍历、查找、删除', code: 'BST' },
  { title: '散列表', to: 'hash/UsingHash.html', note: '基础散列表的增删查', code: 'hash' },
  { title: '分离链接散列表', to: 'hash/usingHashTableSeparateChaining.html', note: '冲突用链表解决', code: 'hash' },
  { title: '线性探测散列表', to: 'hash/linearProbing.html', note: '冲突了往后挪一位，能看到每个键最终落在哪', code: 'hash' },
  { title: '字典', to: 'dictionary/UsingDictionary.html', note: '以键值对形式存储数据', code: 'dictionary' },
  { title: '集合', to: 'set/UsingSet.html', note: '并集、交集、差集、子集判断', code: 'set' },
  { title: '图', to: 'graph/usinggraph.html', note: '邻接表、广度优先、深度优先、最短路径', code: 'graph' }
];

const sources: Entry[] = [
  { title: '栈', to: 'stack/stack.js', code: 'stack/stack.js' },
  { title: '队列', to: 'Queue/Queue.js', code: 'Queue/Queue.js' },
  { title: '二叉搜索树', to: 'trees/binarySearchTree.js', code: 'trees/binarySearchTree.js' },
  { title: '图', to: 'graph/graph.js', code: 'graph/graph.js' },
  { title: '散列表', to: 'hash/hashTable.js', code: 'hash/hashTable.js' },
  { title: '分离链接', to: 'hash/HashTableSeparateChaining.js', code: 'hash/HashTableSeparateChaining.js' },
  { title: '线性探测', to: 'hash/LinearProbing.js', code: 'hash/LinearProbing.js' },
  { title: '链表', to: 'hash/LinkedList.js', code: 'hash/LinkedList.js' },
  { title: '字典', to: 'dictionary/dictionary.js', code: 'dictionary/dictionary.js' },
  { title: '集合', to: 'set/set.js', code: 'set/set.js' }
];

function exists(to: string) {
  try {
    return statSync(path.join(ROOT, ...to.split('/'))).isFile();
  } catch {
    return false;
  }
}

function keep(list: Entry[]) {
  return list.filter((e) => (exists(e.to) ? true : (console.warn('[datastructures] 找不到 ' + e.to), false)));
}

const shownDemos = keep(demos);
const shownSources = keep(sources);

/** 分区顺序：演示排最前（点开就能看），讲解其次，源码最后 */
const sections: LabSection[] = [
  {
    kind: 'rows',
    title: '演示',
    note: '点开就能看，行尾是对应的实现文件名。带「讲解」标记的，可以先看步骤拆解再回来点开。',
    links: shownDemos.map((d) => {
      const g = guideByDemo.get(d.to);
      return {
        href: `/lab/datastructures/${encodeURI(d.to)}`,
        title: d.title,
        note: d.note,
        code: d.code,
        pill: g ? { href: `/lab/datastructures/${g.id}/`, label: '讲解' } : undefined,
        // 这个区有的行有「讲解」胶囊、有的没有，全排成两栏才对得齐
        twoCol: true
      };
    })
  },
  {
    kind: 'rows',
    title: '跟着做一遍',
    note: '八个结构，每个一份步骤拆解。从「解决什么问题」开始，一步一步把代码写出来，最后说清楚复杂度和容易踩的坑。看完想动手，再点开对应的演示页对着跑。',
    links: guides.map((g, i) => ({
      href: `/lab/datastructures/${g.id}/`,
      no: pad(i + 1),
      title: g.data.title,
      note: g.data.gist ?? g.data.summary
    }))
  },
  {
    kind: 'mini',
    title: '源码',
    note: '直接点开是文本，浏览器会原样显示。',
    links: shownSources.map((s) => ({ href: `/lab/datastructures/${encodeURI(s.to)}`, title: s.title }))
  }
];
---

<LabListPage
  title="数据结构练习"
  description="读《学习 JavaScript 数据结构与算法》时手写的基础数据结构，附能在浏览器里直接跑的演示页。"
  eyebrow="LAB / DATA STRUCTURES"
  intro={[
    '读《学习 JavaScript 数据结构与算法》时手写了一遍基础结构。源码就是普通的 <code>.js</code> 文件，下面这些演示页是另外写的，用来验证实现对不对。演示页的结果原本只打在控制台里，所以当年直接打开是一片空白——现在给它们加了一层输出镜像，结果会直接画在页面上，不用按 F12 了。',
    '另外补了一套「跟着做一遍」，把八个结构从思路到代码一步步拆开。当年看书时最想要的就是这种版本。'
  ]}
  sections={sections}
/>
