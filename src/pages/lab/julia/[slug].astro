---
import { statSync } from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const ROOT = path.join(process.cwd(), 'public', 'lab', 'julia');

export async function getStaticPaths() {
  const all = (await getCollection('julia')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      no: i + 1,
      total: all.length,
      prev: all[i - 1] ?? null,
      next: all[i + 1] ?? null
    }
  }));
}

const { entry, no, total, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

/** 脚本都在 public 里按原样托管，构建时确认文件真的在 */
function labFile(to?: string) {
  if (!to) return null;
  const full = path.join(ROOT, ...to.split('/'));
  try {
    if (statSync(full).isFile()) {
      // 逐段编码即可，别再套一层 encodeURI，否则 % 会被二次转义
      return '/lab/julia/' + to.split('/').map(encodeURIComponent).join('/');
    }
  } catch {}
  return null;
}

const scriptUrl = labFile(entry.data.script ? `scripts/${entry.data.script}` : undefined);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="wrap page-head">
    <a class="crumb" href="/lab/julia/">
      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
        <path d="M13 8H3M7 4L3 8l4 4"></path>
      </svg>
      Julia 统计模拟
    </a>

    <p class="eyebrow">LAB / JULIA / {pad(no)} OF {pad(total)}</p>
    <h1>{entry.data.title}</h1>
    <p class="muted">{entry.data.summary}</p>

    {
      (entry.data.gist || entry.data.chapter) && (
        <div class="meta">
          {entry.data.gist && <p class="meta__gist">{entry.data.gist}</p>}
          {entry.data.chapter && <p class="meta__from">{entry.data.chapter} · 原仓库 my-julia</p>}
        </div>
      )
    }
  </div>

  <div class="wrap guide">
    {
      toc.length >= 3 && (
        <nav class="guide__toc" aria-label="本篇内容">
          <p class="guide__toc-label">本篇内容</p>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      scriptUrl && (
        <div class="acts">
          <a class="act" href={scriptUrl}>
            <span class="act__k">完整脚本</span>
            <span class="act__v">{entry.data.script} —— 直接点开是文本，复制到本地就能跑</span>
          </a>
          <div class="act act--static">
            <span class="act__k">怎么运行</span>
            <span class="act__v">
              装好 Julia 后进到 <code>scripts/</code> 目录，执行 <code>julia {entry.data.script}</code>
            </span>
          </div>
        </div>
      )
    }

    <nav class="pager" aria-label="相邻篇目">
      {
        prev ? (
          <a class="pager__item" href={`/lab/julia/${prev.id}/`}>
            <span class="pager__dir">上一篇</span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="pager__item pager__item--right" href={`/lab/julia/${next.id}/`}>
            <span class="pager__dir">下一篇</span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>

    <p class="back">
      <a class="more-link" href="/lab/julia/">
        <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4"></path>
        </svg>
        全部篇目与脚本
      </a>
    </p>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: 56px 30px;
  }

  .crumb {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--fg-faint);
    margin-bottom: 22px;
    transition: color 0.18s ease;
  }

  .crumb:hover {
    color: var(--accent);
  }

  .page-head h1 {
    font-size: clamp(1.9rem, 5vw, 2.5rem);
    margin: 0 0 12px;
    letter-spacing: -0.03em;
  }

  .page-head .muted {
    margin: 0;
    max-width: 46em;
    font-size: 0.95rem;
    line-height: 1.85;
  }

  .meta {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .meta__gist {
    margin: 0;
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .meta__from {
    margin: 14px 0 0;
    font-size: 0.78rem;
    color: var(--fg-faint);
  }

  .guide {
    padding-bottom: 96px;
  }

  .guide__toc {
    margin: 0 0 36px;
    padding: 18px 22px;
    background: var(--bg-sunken);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .guide__toc-label {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .guide__toc ol {
    margin: 0;
    padding-left: 1.35em;
    font-size: 0.88rem;
    line-height: 2;
    color: var(--fg-muted);
  }

  .guide__toc a {
    color: var(--fg-muted);
    transition: color 0.18s ease;
  }

  .guide__toc a:hover {
    color: var(--accent);
  }

  .acts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
    margin: 44px 0 0;
  }

  .act {
    display: block;
    padding: 16px 18px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  a.act:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .act--static {
    background: transparent;
    border-style: dashed;
  }

  .act__k {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .act__v {
    display: block;
    margin-top: 7px;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--fg-muted);
    word-break: break-all;
  }

  .act__v code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--fg);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 40px 0 0;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .pager__item {
    display: block;
    min-width: 0;
  }

  .pager__item--right {
    text-align: right;
  }

  .pager__dir {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 7px;
  }

  .pager__title {
    display: block;
    font-size: 0.95rem;
    color: var(--fg);
    transition: color 0.18s ease;
  }

  .pager__item:hover .pager__title {
    color: var(--accent);
  }

  .back {
    margin: 32px 0 0;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.86rem;
    color: var(--fg-muted);
    transition: color 0.18s ease;
  }

  .more-link:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .acts,
    .pager {
      grid-template-columns: 1fr;
    }
    .pager__item--right {
      text-align: left;
    }
  }
</style>
