---
import { statSync } from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import LabArticle from '../../../components/LabArticle.astro';

const ROOT = path.join(process.cwd(), 'public', 'lab', 'julia');

export async function getStaticPaths() {
  const all = (await getCollection('julia')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      no: i + 1,
      total: all.length,
      prev: all[i - 1] ?? null,
      next: all[i + 1] ?? null
    }
  }));
}

const { entry, no, total, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

/** 脚本都在 public 里按原样托管，构建时确认文件真的在 */
function labFile(to?: string) {
  if (!to) return null;
  const full = path.join(ROOT, ...to.split('/'));
  try {
    if (statSync(full).isFile()) {
      // 逐段编码即可，别再套一层 encodeURI，否则 % 会被二次转义
      return '/lab/julia/' + to.split('/').map(encodeURIComponent).join('/');
    }
  } catch {}
  return null;
}

const scriptUrl = labFile(entry.data.script ? `scripts/${entry.data.script}` : undefined);
const pad = (n: number) => String(n).padStart(2, '0');

const acts = scriptUrl
  ? [
      {
        href: scriptUrl,
        kind: '完整脚本',
        desc: `${entry.data.script} —— 直接点开是文本，复制到本地就能跑`
      },
      {
        kind: '怎么运行',
        desc: '装好 Julia 后进到 scripts/ 目录，执行',
        code: `julia ${entry.data.script}`,
        static: true
      }
    ]
  : [];
---

<LabArticle
  title={entry.data.title}
  description={entry.data.summary}
  crumbHref="/lab/julia/"
  crumbLabel="Julia 统计模拟"
  eyebrow={`LAB / JULIA / ${pad(no)} OF ${pad(total)}`}
  summary={entry.data.summary}
  gist={entry.data.gist}
  metaFrom={entry.data.chapter ? [`${entry.data.chapter} · 原仓库 my-julia`] : []}
  toc={toc}
  prev={prev && { href: `/lab/julia/${prev.id}/`, title: prev.data.title }}
  next={next && { href: `/lab/julia/${next.id}/`, title: next.data.title }}
  backHref="/lab/julia/"
  backLabel="全部篇目与脚本"
  acts={acts}
>
  <Content />
</LabArticle>
