---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime, postUrl, tagSlug } from '../../utils/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const names = new Set(posts.map((p) => p.data.category?.trim() || '随笔'));

  return [...names].map((name) => ({
    params: { tag: tagSlug(name) },
    props: {
      name,
      posts: posts
        .filter((p) => (p.data.category?.trim() || '随笔') === name)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    }
  }));
}

const { name, posts } = Astro.props;
---

<BaseLayout title={name} description={`${name} 分类下的 ${posts.length} 篇笔记。`}>
  <div class="wrap page-head">
    <span class="eyebrow">TOPIC</span>
    <h1>{name}</h1>
    <p class="muted">共 {posts.length} 篇</p>
  </div>

  <div class="wrap" style="padding-bottom:88px">
    <ul class="rows">
      {
        posts.map((post) => (
          <li>
            <a class="row" href={postUrl(post.id)}>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <div class="row__main">
                <h2>{post.data.title}</h2>
                <p>{post.data.summary}</p>
              </div>
              <span class="row__time">{readingTime(post.body ?? '')}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="back">
      <a class="more-link" href="/tags/">
        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4"></path>
        </svg>
        全部分类
      </a>
    </p>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: 64px 40px;
  }

  .page-head h1 {
    font-size: clamp(1.9rem, 5vw, 2.4rem);
    margin: 0 0 12px;
    letter-spacing: -0.03em;
  }

  .page-head p {
    margin: 0;
    font-size: 0.95rem;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rows li + li {
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: 22px;
    align-items: baseline;
    padding: 22px 12px;
    margin-inline: -12px;
    border-radius: var(--radius);
    color: var(--fg);
    transition: background-color 0.18s ease;
  }

  .row:hover {
    background: var(--bg-sunken);
  }

  .row time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-faint);
  }

  .row__main h2 {
    margin: 0 0 6px;
    font-size: 1.06rem;
    transition: color 0.18s ease;
  }

  .row:hover .row__main h2 {
    color: var(--accent);
  }

  .row__main p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .row__time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .back {
    margin: 40px 0 0;
  }

  @media (max-width: 700px) {
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 20px 0;
      margin-inline: 0;
    }
    .row__time {
      display: none;
    }
  }
</style>
